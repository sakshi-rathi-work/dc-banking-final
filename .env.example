# Distributed Banking System - Environment Configuration Example

# Node Identity and Network
NODE_ID=a
NODE_PORT=3000
DATABASE_URL=postgres://bank_a:pw_a@postgres-a:5432/bank
PEERS=a=http://bank-node-a:3000,b=http://bank-node-b:3000,c=http://bank-node-c:3000,d=http://bank-node-d:3000
COORDINATOR_URL=http://bank-coordinator:8080

# Bootstrap
BOOTSTRAP_PRIMARY=false

# Cluster & Failure Detection Timers
HEARTBEAT_INTERVAL_MS=1000
FAILURE_TIMEOUT_MS=4000
LEADER_LEASE_MS=3000
DISCOVERY_WINDOW_MS=5000
RPC_TIMEOUT_MS=2000
LEADER_WAIT_MS=15000

# Replication
REPLICATION_MODE=ASYNC
SYNC_ACKS=2
SYNC_TIMEOUT_MS=3000
ASYNC_BATCH_INTERVAL_MS=100
REPL_BATCH_SIZE=100
READ_MAX_LAG_LSN=5

# Election
ELECTION_ALGORITHM=bully
BULLY_OK_TIMEOUT_MS=2000
COORDINATOR_WAIT_MS=5000
ELECTION_HOP_TIMEOUT_MS=1500
RING_TIMEOUT_MS=8000
BACKUP_GRACE_MS=5000

# Clocks
CLOCK_OFFSET_MS=0
CLOCK_DRIFT_PPM=0
COORDINATOR_CLOCK_OFFSET_MS=0
BERKELEY_OUTLIER_MS=10000

# Workers
WORKER_POOL_SIZE=4
BATCH_TIMEOUT_MS=30000

# Load Balancing
LB_ALGORITHM=round-robin
LB_HEALTH_INTERVAL_MS=1000
LB_UNHEALTHY_THRESHOLD=2
LB_RECOVERY_THRESHOLD=3

# Control & Debug
ENABLE_FAULT_INJECTION=true
DOCKER_CONTROL_ENABLED=false
LOG_LEVEL=info
MAX_TXN_AMOUNT=1000000.00
